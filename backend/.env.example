# backend/.env.example - copy to backend/.env for local dev.
# On Render, set these on the CRM backend service → Environment.

# Neon Postgres: console.neon.tech → your project → Connect → copy the
# connection string. Prefer the direct one (host without "-pooler"); the
# pooled one works too. channel_binding=require in Neon's string is fine.
# Format: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
CRM_DATABASE_URL=

# Browser origin(s) of the CRM frontend, comma-separated.
CRM_FRONTEND_ORIGIN=http://localhost:5174

# Google Workspace sign-in. Create an OAuth client in Google Cloud for an
# app with User type = Internal, then paste its Client ID here.
CRM_GOOGLE_CLIENT_ID=
CRM_ALLOWED_DOMAIN=leadstrategus.com
# These emails become admins the first time they sign in.
CRM_ADMIN_EMAILS=

# Local dev ONLY: trust an "X-Dev-User: name@leadstrategus.com" header
# instead of a Google token. Must be false (or unset) in production.
CRM_DEV_AUTH=false

# Google Calendar + Meet sync (optional). Secret of the same Web OAuth
# client as CRM_GOOGLE_CLIENT_ID; add
#   {CRM_PUBLIC_API_URL}/api/calendar/oauth/callback
# as an authorised redirect URI on it and enable the Google Calendar API.
CRM_GOOGLE_CLIENT_SECRET=
CRM_PUBLIC_API_URL=http://localhost:8100
# Any long random string. Encrypts stored Google refresh tokens; changing
# it means everyone reconnects their calendar.
CRM_TOKEN_KEY=

# HubSpot import: access token of a HubSpot private app with read-only
# CRM scopes (HubSpot → Settings → Integrations → Private apps).
# Server-side only; leave empty until you run the import.
CRM_HUBSPOT_TOKEN=

# §5.4 manager escalation: business days overdue before flagging.
CRM_ESCALATION_BUSINESS_DAYS=3
