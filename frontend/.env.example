# frontend/.env.example - copy to .env.local for local dev.

# CRM API base URL. Leave empty in dev (Vite proxies /api to :8100).
# Production example: https://leadstrategus-crm-api.onrender.com
VITE_API_URL=

# OAuth Client ID of the Internal Google app (same as CRM_GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Local dev ONLY, with CRM_DEV_AUTH=true on the API: sign in as this
# Workspace email without Google. Leave empty in production builds.
VITE_DEV_USER=
